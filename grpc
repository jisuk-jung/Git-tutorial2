방법 2: gRPC 채널 및 생성된 클라이언트 직접 사용
특정 고급 시나리오나 저수준 통신이 필요한 경우, DaprClient.CreateInvocationInvoker를 사용하여 gRPC 채널을 구성하고, 그 채널을 통해 생성된 gRPC 클라이언트를 직접 사용할 수 있습니다. 
클라이언트 코드 예제:

csharp
using Grpc.Net.Client;
using Grpc.Core;
// GrpcGreeterClient는 proto 파일로부터 생성된 클라이언트 스텁입니다.
using GrpcGreeter; 

// 대상 서비스의 Dapr 앱 ID 및 엔드포인트 설정
var myAppId = "grpcserverapp";
// Dapr 사이드카 gRPC 엔드포인트 (기본값: 50001)
var daprGrpcEndpoint = "http://localhost:50001"; 

// Dapr 인보케이션 인보커(invoker) 생성
var invoker = DaprClient.CreateInvocationInvoker(appId: myAppId, daprEndpoint: daprGrpcEndpoint);

// 인보커를 사용하여 gRPC 클라이언트 생성
var client = new Greeter.GreeterClient(invoker);

// gRPC 호출 옵션 설정
var options = new CallOptions(cancellationToken: CancellationToken.None, deadline: DateTime.UtcNow.AddSeconds(5));

// gRPC 메서드 호출
var reply = await client.SayHelloAsync(new HelloRequest { Name = "World" }, options);

Console.WriteLine("Greeting: " + reply.Message);

